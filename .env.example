# Скопируйте этот файл в .env и заполните нужное:
#
#   cp .env.example .env
#
# delegirium читает .env сам — экспортировать переменные вручную не нужно.
# Переменные, уже заданные в окружении (shell/CI), имеют приоритет над .env.

# auto | openai | openrouter | recorded
DELEGIRIUM_PROVIDER=auto

# --- OpenRouter (рекомендуется) --------------------------------------------
DELEGIRIUM_OPENROUTER_KEY=
DELEGIRIUM_OPENROUTER_URL=https://api.ru-openrouter.ru/v1
DELEGIRIUM_OPENROUTER_MODEL=openai/gpt-4o-mini
# DELEGIRIUM_OPENROUTER_REFERER=https://example.com

# --- OpenAI или любой OpenAI-совместимый endpoint --------------------------
# DELEGIRIUM_API_KEY=sk-...
# DELEGIRIUM_API_URL=https://api.openai.com/v1/chat/completions
# DELEGIRIUM_MODEL=gpt-4.1-mini

# --- Сеть (если провайдер не отвечает) -------------------------------------
# DELEGIRIUM_HTTP=auto            # auto | curl | stream
# DELEGIRIUM_PROXY=host:port
# DELEGIRIUM_CAFILE=C:\php\extras\ssl\cacert.pem
# DELEGIRIUM_INSECURE=0           # 1 — только для диагностики

# --- Прочее ----------------------------------------------------------------
# DELEGIRIUM_CACHE_DIR=.delegirium-cache
# DELEGIRIUM_ENV_FILE=.env.local
# DELEGIRIUM_RECORD=1            # 1 -> fixtures/recorded.php, или путь к файлу
